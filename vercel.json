{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/profile/:code",
      "has": [
        { "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|Slackbot|Slack-ImgProxy|WhatsApp|TelegramBot|Discordbot|Googlebot|bingbot|Applebot|redditbot|Pinterest|vkShare|W3C_Validator|SkypeUriPreview|embedly|Iframely|nuzzel|Google-InspectionTool|Mastodon|BlueSky|Bluesky).*" }
      ],
      "destination": "/api/og?code=:code"
    },

    { "source": "/sitemap.xml", "destination": "/api/sitemap?kind=index" },
    { "source": "/sitemap-hubs.xml", "destination": "/api/sitemap?kind=hubs" },
    { "source": "/sitemap-companies-:n.xml", "destination": "/api/sitemap?kind=companies&n=:n" },

    { "source": "/companies/:slug", "destination": "/api/seo?kind=company&a=:slug" },
    { "source": "/jobs/remote/:role", "destination": "/api/seo?kind=remote&a=:role" },
    { "source": "/jobs/in/:state", "destination": "/api/seo?kind=state&a=:state" },
    { "source": "/jobs/:role/:state", "destination": "/api/seo?kind=role&a=:role&b=:state" },
    { "source": "/jobs/:role", "destination": "/api/seo?kind=role&a=:role" },

    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
